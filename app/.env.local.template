# Copy this file to `.env.local` if you need to override anything.
# Vite reads variables prefixed with VITE_ at build time.
#
# frontier go needs NO API keys. Every provider request happens in the
# ingestion workflow (`npm run ingest`) and the app ships with the result, so
# `npm run dev` and `npm run build` work on a clean checkout with no .env.local
# at all.

# Optional. The live privacy page, linked from the Profile screen.
# Example: https://frontier-go.vercel.app/privacy
VITE_PRIVACY_POLICY_URL=
